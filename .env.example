# Copiar este archivo a `.env` (sin .example) y ajustar.
# ------------------------------------------------------
#
# ⚠️ ESTE ARCHIVO SE COMMITEA AL REPO. Es la plantilla: dice qué variables
# existen, con valores de ejemplo. **Nunca pongas acá una credencial real.**
#
# El pre-commit hook bloquea `.env`, pero tiene una excepción explícita para
# `.env.example` — o sea que un secreto puesto acá **no lo frena nadie**.
# Los valores de verdad van en:
#   * `.env` (local, ignorado por git)
#   * `fly secrets set CLAVE=valor -a superapp-finanzas` (producción)

# Ruta a la base SQLite donde la app guarda tus transacciones.
DB_PATH=./data/finanzas.db

# Ruta al CSV de transacciones diarias (sólo se usa en la importación inicial).
DIARIO_CSV=./Diario.csv

# Ruta al CSV mensual con previsión vs realidad (sólo se usa en la importación inicial).
MENSUAL_CSV=./Mensual.csv

# Saldo del fondo de emergencia en USD. Por ahora informativo; se muestra en el dashboard.
FONDO_EMERGENCIA_USD=864

# Cantidad de copias de backup a retener.
BACKUP_RETENTION=30

# --- Seguridad (premortem #3) ---

# Código de invitación para crear cuentas nuevas. Si NO está definido,
# el signup queda deshabilitado (solo login). En Fly:
#   fly secrets set SIGNUP_CODE=elegir-un-codigo
# SIGNUP_CODE=

# Secret para los tokens de sesión "recordarme" (evita re-login en cada
# refresh). Si NO está definido, la sesión funciona como siempre (solo
# st.session_state). Generar con: openssl rand -hex 32. En Fly:
#   fly secrets set SESSION_SECRET=<valor>
# Rotarlo invalida todas las sesiones recordadas.
# SESSION_SECRET=

# --- WhatsApp (Fase A, ADR-0008; paso a paso en docs/WHATSAPP-CANAL.md) ---
# Sin estas variables el webhook responde 503 y el resto de la app anda igual.
# NINGUNA tiene valor por defecto: los valores reales van solo a `fly secrets`.

# Token permanente del usuario del sistema de Meta.
# WHATSAPP_TOKEN=
# "Identificador del número de teléfono" del número de prueba.
# WHATSAPP_PHONE_NUMBER_ID=
# Clave secreta de la app de Meta: verifica la firma de cada webhook.
# WHATSAPP_APP_SECRET=
# Texto al azar que se escribe también en el panel del webhook.
# WHATSAPP_VERIFY_TOKEN=
# Único número que puede cargar gastos (549 + área + número).
# WHATSAPP_NUMERO_AUTORIZADO=
# Usuario de la tabla `usuarios` al que se le cargan los gastos.
# SUPERAPP_DEFAULT_USER=
# Opcional: id del workspace (si no, el personal del usuario).
# SUPERAPP_DEFAULT_WORKSPACE=
# Opcional: versión de la Graph API (default v23.0, la probada el 15/10/2026).
# WHATSAPP_GRAPH_VERSION=

# --- Briefings por WhatsApp (Fase B, ADR-0008) ---
# Token que usa el Apps Script para `POST /api/briefing` (Bearer). Sin él, la
# ruta responde 503. Generar con: openssl rand -hex 32. Va también en las
# Propiedades del script como SUPERAPP_TOKEN.
# SUPERAPP_API_TOKEN=

# --- Agenda por WhatsApp (Fase B, paso 3) ---
# URL /exec de la aplicación web del Apps Script (Codigo.gs). Sin estas dos,
# `evento:` / `tarea:` / `agenda` contestan que la agenda no está conectada.
# GOOGLE_WORKSPACE_WEBHOOK_URL=
# El mismo valor que SECRETO_WEBHOOK en las Propiedades del script.
# GOOGLE_WORKSPACE_SECRET=
